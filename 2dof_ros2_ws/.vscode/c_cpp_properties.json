{
    "configurations": [
        {
            "browse": {
                "databaseFilename": "${default}",
                "limitSymbolsToIncludedHeaders": false
            },
            "includePath": [
                "/opt/ros/humble/include/**",
                "${workspaceFolder}/2dof_ros2_ws/src/turret_control/include/**",
                 "${workspaceFolder}/2dof_ros2_ws/src/turret_camera/include/**",
                "/usr/include/**",
                "${workspaceFolder}/install/custom_msgs/include",
                "${workspaceFolder}/install/custom_msgs/include/custom_msgs"
            ],
            "name": "ROS",
            "intelliSenseMode": "gcc-x64",
            "compilerPath": "/usr/bin/gcc",
            "cStandard": "gnu11",
            "cppStandard": "c++14"
        }
    ],
    "version": 4
}